<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>ClaudeProtection</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Explicit daily boundary: no Job, sandbox workers or fault injection. -->
    <Compile Include="Program.cs;Models.cs;EnvironmentAudit.cs;ProcessIdentity.cs;ProxySettings.cs;UserProxyBaseline.cs;StrictPreflight.cs;DiagnosticNetworkTargetPolicy.cs" />
    <Compile Include="../Shared/UserDataPaths.cs" Link="UserDataPaths.cs" />
    <Compile Include="../Shared/ProxyDestinationPolicy.cs" Link="ProxyDestinationPolicy.cs" />
    <Compile Include="../Shared/StrictEnvironmentRequirements.cs" Link="StrictEnvironmentRequirements.cs" />
    <Compile Include="../Shared/WorkspaceBundle.cs;../Shared/WorkspaceFiles.cs" />
    <Compile Include="WorkspaceProcessing.cs;WorkspaceInstalledHost.cs;../Shared/WorkspacePipe.cs" />
    <Compile Include="../Shared/TextSummarySource.cs" />
    <Compile Include="../Shared/CSharpProjectTask.cs" />
    <Compile Include="../Shared/HostPrivacyContract.cs;../Shared/ProjectFailure.cs" />
    <EmbeddedResource Include="../../samples/TextSummary/TextSummary.csproj" LogicalName="ClaudeCodeProtection.TextSummary.TextSummary.csproj" />
    <EmbeddedResource Include="../../samples/TextSummary/TextSummary.cs" LogicalName="ClaudeCodeProtection.TextSummary.TextSummary.cs" />
    <EmbeddedResource Include="../../samples/TextSummary/ProjectTests.cs" LogicalName="ClaudeCodeProtection.TextSummary.ProjectTests.cs" />
    <EmbeddedResource Include="../../samples/TextSummary/README.md" LogicalName="ClaudeCodeProtection.TextSummary.README.md" />
    <Compile Include="../Shared/WindowsDirectoryNames.cs;../ProtectionLifecycle/DirectoryNamePage.cs" />
    <None Include="../../scripts/Read-Environment.ps1" Link="Read-Environment.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
