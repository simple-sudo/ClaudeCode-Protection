<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>ProtectionCenter</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="App.cs;BackendClient.cs;PreflightDisplay.cs;WorkspaceResultSession.cs;ProjectTaskWindow.cs;ProjectEditQueue.cs" />
    <Compile Include="CallerProjectSession.cs;../Shared/CSharpProjectTask.cs;../Shared/HostPrivacyContract.cs;../Shared/ProjectFailure.cs;../Shared/WorkspaceStopControl.cs" />
    <Compile Include="../ClaudeProtection/WorkspaceInstalledHost.cs" Link="WorkspaceInstalledHost.cs" />
    <Compile Include="../Shared/WorkspaceBundle.cs" Link="WorkspaceBundle.cs" />
    <Compile Include="../Shared/WorkspaceFiles.cs" Link="WorkspaceFiles.cs" />
    <Compile Include="../Shared/WindowsDirectoryNames.cs" Link="WindowsDirectoryNames.cs" />
    <Compile Include="../ProtectionLifecycle/DirectoryNamePage.cs" Link="DirectoryNamePage.cs" />
    <Compile Include="../Shared/UserDataPaths.cs" Link="UserDataPaths.cs" />
    <Compile Include="../Shared/StrictEnvironmentRequirements.cs" Link="StrictEnvironmentRequirements.cs" />
  </ItemGroup>
</Project>
