<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>ProtectionLifecycle</AssemblyName>
    <RootNamespace>ProtectionLifecycle</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PackagePolicy.cs;FixedLayout.cs;WindowsPathSeal.cs;ProtectedState.cs;Lifecycle.cs;BrokerProtocol.cs;VersionStore.cs;LifecycleRecovery.cs;ExactUninstall.cs;RemovalPolicy.cs;CreationIdentity.cs;PendingFileAuthority.cs;CompletionRecovery.cs;KernelJobSeal.cs;OwnedJobs.cs;PrivateJobNamespace.cs;WfpNative.cs;FencePlan.cs;PersistentFence.cs;InstalledBroker.cs;BootstrapInstaller.cs" />
    <Compile Include="WfpObjectContract.cs" />
    <Compile Include="AtomicAdmission.cs" />
    <Compile Include="ProxyChannel.cs;NetworkQualification.cs" />
    <Compile Include="GpuQualification.cs" />
    <Compile Include="ProcessLocalRevocation.cs" />
    <EmbeddedResource Include="LifecycleProtocol.json" />
    <EmbeddedResource Include="BrokerProtocol.json" />
    <EmbeddedResource Include="RecoveryProtocol.json" />
    <EmbeddedResource Include="RemovalProtocol.json" />
  </ItemGroup>
</Project>
