<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>ProtectionLifecycle</AssemblyName>
    <RootNamespace>ProtectionLifecycle</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PackagePolicy.cs;FixedLayout.cs;WindowsPathSeal.cs;ProtectedState.cs;Lifecycle.cs;BrokerProtocol.cs;VersionStore.cs;LifecycleRecovery.cs;ExactUninstall.cs;RemovalPolicy.cs;CreationIdentity.cs;PendingFileAuthority.cs;CompletionRecovery.cs;KernelJobSeal.cs;OwnedJobs.cs;PrivateJobNamespace.cs;WfpNative.cs;FencePlan.cs;PersistentFence.cs;InstalledBroker.cs;BootstrapInstaller.cs" />
    <Compile Include="WfpObjectContract.cs" />
    <Compile Include="DirectoryNamePage.cs" />
    <Compile Include="WorkspaceDataChannel.cs;../Shared/WorkspacePipe.cs" />
    <Compile Include="../Shared/WindowsDirectoryNames.cs" />
    <Compile Include="AtomicAdmission.cs" />
    <Compile Include="ProxyChannel.cs;NetworkQualification.cs" />
    <Compile Include="GpuQualification.cs" />
    <Compile Include="ProcessLocalRevocation.cs" />
    <Compile Include="ProtectionRuntimeLease.cs" />
    <Compile Include="SessionProxy.cs;ProtectedSession.cs" />
    <Compile Include="SessionResources.cs" />
    <Compile Include="SessionManifestReadAccess.cs" />
    <Compile Include="OwnedToolLaunch.cs" />
    <Compile Include="ToolFaultMode.cs" />
    <Compile Include="SessionProfileRecovery.cs" />
    <Compile Include="SessionGitToolchain.cs" />
    <Compile Include="SessionPowerShellToolchain.cs" />
    <Compile Include="SessionTaskWorkspace.cs" />
    <Compile Include="../Shared/WorkspaceBundle.cs;../Shared/WorkspaceFiles.cs" />
    <Compile Include="../Shared/ProxyDestinationPolicy.cs" Link="ProxyDestinationPolicy.cs" />
    <Compile Include="../Shared/LoopbackTcpTable.cs" Link="LoopbackTcpTable.cs" />
    <Compile Include="../Shared/StrictEnvironmentRequirements.cs" Link="StrictEnvironmentRequirements.cs" />
    <Compile Include="../Shared/EnvironmentExpectations.cs" Link="EnvironmentExpectations.cs" />
    <Compile Include="../Shared/FenceMigrationSelection.cs" Link="FenceMigrationSelection.cs" />
    <Compile Include="../Shared/SessionTunnel.cs" Link="SessionTunnel.cs" />
    <EmbeddedResource Include="LifecycleProtocol.json" />
    <EmbeddedResource Include="PowerShellToolchain.json" />
    <EmbeddedResource Include="BrokerProtocol.json" />
    <EmbeddedResource Include="RecoveryProtocol.json" />
    <EmbeddedResource Include="RemovalProtocol.json" />
  </ItemGroup>
</Project>
