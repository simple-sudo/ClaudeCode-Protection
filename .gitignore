# Source allowlist: unknown root data stays outside version history.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/Protection.cmd
!/Inspect.cmd
!/Test-ClaudeEnvironment.ps1
!/docs/
!/scripts/
!/src/
!/tests/
!/samples/
/samples/*
!/samples/TextSummary/
!/.github/

# Preserve on disk; never stage runtime state or historical evidence.
**/bin/
**/obj/
**/logs/
**/state/
**/backups/
**/upstream/
**/work/
**/outputs/
**/.vs/
**/.vscode/
**/TestResults/
**/node_modules/
*.log
*.jsonl
*.pid
*.lock
*.wfw
*system-before*.json
settings*.json
*.user
*.suo

# Generated executable content, packages and caches.
*.exe
*.dll
*.obj
*.pdb
*.lib
*.exp
*.msi
*.msix
*.zip
*.nupkg
*.cache
*.pyc
__pycache__/

# Credentials and local-only configuration, including accidental copies.
.env
.env.*
*.key
*.pem
*.pfx
*.p12
*.kdbx
credentials.json
auth.json
secrets.json
**/secrets/
**/credentials/
