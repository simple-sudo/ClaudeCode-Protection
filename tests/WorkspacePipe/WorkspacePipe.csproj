<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exact ordinary IPC and output reservation only. No UAC or Broker. -->
    <Compile Include="Program.cs;../../src/Shared/WorkspacePipe.cs;../../src/Shared/WorkspaceBundle.cs;../../src/Shared/WorkspaceFiles.cs" />
    <Compile Include="../../src/Shared/WindowsDirectoryNames.cs;../../src/ProtectionLifecycle/DirectoryNamePage.cs" />
    <Compile Include="../../src/Shared/TextSummarySource.cs" />
    <EmbeddedResource Include="../../samples/TextSummary/TextSummary.csproj" LogicalName="ClaudeCodeProtection.TextSummary.TextSummary.csproj" />
    <EmbeddedResource Include="../../samples/TextSummary/TextSummary.cs" LogicalName="ClaudeCodeProtection.TextSummary.TextSummary.cs" />
    <EmbeddedResource Include="../../samples/TextSummary/ProjectTests.cs" LogicalName="ClaudeCodeProtection.TextSummary.ProjectTests.cs" />
    <EmbeddedResource Include="../../samples/TextSummary/README.md" LogicalName="ClaudeCodeProtection.TextSummary.README.md" />
  </ItemGroup>
</Project>
